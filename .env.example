# MySQL
DB_USERNAME=careerpulse
DB_PASSWORD=YOUR_DB_PASSWORD

# FastAPI
AI_SERVER_URL=http://127.0.0.1:8000

# Scheduled job collection
JOB_COLLECTION_ENABLED=false
# Spring cron: second minute hour day month weekday
# JOB_COLLECTION_CRON=0 0 3 * * *
# JOB_COLLECTION_RETRY_DELAY_MS=60000

# Gemini API
GEMINI_API_KEY=YOUR_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# RAG embedding
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_EMBEDDING_DEVICE=cpu
RAG_ALLOW_HASH_FALLBACK=false
RAG_MIN_DENSE_SCORE=0.45
# FastAPI를 ai 폴더에서 실행할 때의 Chroma 영속 저장 경로
RAG_CHROMA_PATH=.chroma

# Email notifications (disabled by default to prevent accidental delivery)
MAIL_ENABLED=false
MAIL_NOTIFICATION_CRON=0 0 9 * * *
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
